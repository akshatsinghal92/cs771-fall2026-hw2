# Submit from the repo root on a CHTC submit node:  condor_submit code/scripts/chtc/cls.sub
universe                = docker
docker_image            = pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

executable              = code/scripts/chtc/run_cls.sh
arguments               = $(config)

# code/ is copied as ./code; configs are read from code/configs
transfer_input_files    = code
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = logs_$Fn(config).tar.gz

log                     = code/scripts/chtc/$Fn(config).log
output                  = code/scripts/chtc/$Fn(config).out
error                   = code/scripts/chtc/$Fn(config).err

request_gpus            = 1
request_cpus            = 4
request_memory          = 16GB
request_disk            = 20GB
+WantGPULab             = true
+GPUJobLength           = "short"

# one job per config
queue config from (
  cls_miniplaces_cnn.yaml
  cls_miniplaces_resnet18.yaml
  cls_miniplaces_simplenet.yaml
)
